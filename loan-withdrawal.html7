    <script>
        (function() {
            const whatsappHelp = document.getElementById('whatsappHelp');
            const whatsappHelpClose = document.getElementById('whatsappHelpClose');

            if (!whatsappHelp || !whatsappHelpClose) return;

            const hideWhatsappHelp = () => {
                whatsappHelp.classList.add('is-hidden');
            };

            const helpTimer = window.setTimeout(hideWhatsappHelp, 4000);
            whatsappHelpClose.addEventListener('click', () => {
                window.clearTimeout(helpTimer);
                hideWhatsappHelp();
            });
        })();
    </script>

