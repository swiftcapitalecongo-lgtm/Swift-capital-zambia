      <style>
          
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');

        :root {
            --primary: #00ff88;
            --primary-dark: #00cc6a;
            --secondary: #00e1ff;
            --error: #ff3366;
            --error-dark: #cc0033;
            --bg-color: #0f172a;
            --card-bg: rgba(30, 41, 59, 0.7);
            --card-border: rgba(255, 255, 255, 0.1);
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Inter', sans-serif;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-main);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            position: relative;
        }

        /* Animated Background */
        .bg-animation {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -1;
            background: radial-gradient(circle at 20% 30%, rgba(0, 255, 136, 0.15) 0%, transparent 50%),
                        radial-gradient(circle at 80% 70%, rgba(0, 225, 255, 0.15) 0%, transparent 50%);
            animation: pulseBg 10s ease-in-out infinite alternate;
        }

        @keyframes pulseBg {
            0% { transform: scale(1); }
            100% { transform: scale(1.1); }
        }

        /* Glassmorphism Card */
        .card {
            background: var(--card-bg);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid var(--card-border);
            border-radius: 24px;
            padding: 40px;
            width: 100%;
            max-width: 420px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
            position: relative;
            z-index: 1;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .header {
            text-align: center;
            margin-bottom: 30px;
        }

        .header h1 {
            font-size: 24px;
            font-weight: 700;
            margin-bottom: 8px;
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .header p {
            color: var(--text-muted);
            font-size: 14px;
        }

        /* Form Elements */
        .input-group {
            margin-bottom: 24px;
            position: relative;
        }

        .input-group label {
            display: block;
            margin-bottom: 8px;
            font-size: 14px;
            font-weight: 500;
            color: var(--text-muted);
        }

        .input-wrapper {
            position: relative;
        }

        .input-wrapper input, .custom-select {
            width: 100%;
            background: rgba(15, 23, 42, 0.6);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 12px;
            padding: 16px 16px 16px 48px;
            color: var(--text-main);
            font-size: 16px;
            outline: none;
            transition: all 0.3s ease;
        }

        .custom-select {
            padding: 16px 16px 16px 16px;
            appearance: none;
            cursor: pointer;
        }

        .custom-select option {
            background: #0f172a;
            color: #fff;
        }

        .input-wrapper input:focus, .custom-select:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 2px rgba(0, 255, 136, 0.2);
        }

        .input-icon {
            position: absolute;
            left: 16px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
            font-size: 18px;
        }

        /* Neon Gradient Button */
        .btn-deposit {
            width: 100%;
            padding: 16px;
            border: none;
            border-radius: 12px;
            background: linear-gradient(135deg, var(--primary-dark), var(--secondary));
            color: #fff;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            position: relative;
            overflow: hidden;
            transition: all 0.3s ease;
            box-shadow: 0 10px 20px -10px rgba(0, 255, 136, 0.5);
        }

        .btn-deposit:hover {
            transform: translateY(-2px);
            box-shadow: 0 15px 25px -10px rgba(0, 255, 136, 0.7);
        }

        .btn-deposit:active {
            transform: translateY(0);
        }

        /* Compact savings information: deliberately styled as text, not a second button/card. */
        .withdrawal-savings-summary {
            margin: 10px 2px 0;
            padding: 0;
            border: 0;
            border-radius: 0;
            background: transparent;
            color: #475569;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 2px;
            text-align: center;
        }
        .withdrawal-savings-label { font-size: 12px; font-weight: 700; color: #047857; }
        .withdrawal-savings-summary strong { font-size: 17px; line-height: 1.3; color: #059669; font-weight: 800; }
        .withdrawal-savings-summary small { margin-top: 2px; font-size: 11px; line-height: 1.4; color: #64748b; max-width: 360px; }

        /* Ripple Effect */
        .ripple {
            position: absolute;
            border-radius: 50%;
            transform: scale(0);
            animation: ripple-anim 0.6s linear;
            background: rgba(255, 255, 255, 0.3);
        }

        @keyframes ripple-anim {
            to { transform: scale(4); opacity: 0; }
        }

        /* Validations */
        .validation-msg {
            font-size: 12px;
            margin-top: 6px;
            display: flex;
            align-items: center;
            gap: 4px;
            opacity: 0;
            transform: translateY(-10px);
            transition: all 0.3s ease;
            position: absolute;
            pointer-events: none;
        }

        .validation-msg.show {
            opacity: 1;
            transform: translateY(0);
            position: relative;
        }

        .text-error { color: var(--error); }
        .text-success { color: var(--primary); }


        .processing-details {
            width: 100%;
            margin-top: 22px;
            padding: 18px;
            text-align: left;
            color: #e2e8f0;
            background: rgba(15, 23, 42, .72);
            border: 1px solid rgba(148, 163, 184, .22);
            border-radius: 16px;
        }
        .processing-details h3 { margin: 0 0 12px; color: #f8fafc; font-size: 15px; font-weight: 700; }
        .processing-detail-row { display: flex; justify-content: space-between; gap: 14px; padding: 9px 0; border-bottom: 1px solid rgba(148,163,184,.15); font-size: 12px; }
        .processing-detail-row span { color: #94a3b8; }
        .processing-detail-row strong { color: #f8fafc; text-align: right; overflow-wrap: anywhere; }
        .processing-detail-row:nth-child(3) strong { color: #86efac; }
        .processing-instructions { margin-top: 16px; padding: 14px; border-radius: 12px; background: rgba(0,225,255,.07); }
        .processing-instructions h4 { margin: 0 0 9px; color: #67e8f9; font-size: 13px; font-weight: 700; }
        .processing-instructions ol { margin: 0; padding-left: 20px; color: #dbeafe; font-size: 12px; line-height: 1.65; }
        .processing-instructions li { margin: 0 0 6px; }
        .processing-security-note { margin-top: 12px; color: #fcd9a6; font-size: 11px; line-height: 1.55; }
        @media (max-width: 480px) { .processing-details { padding: 14px; } .processing-detail-row { font-size: 11px; } }

        /* Loader */
        .loader-container {
            display: none;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            animation: fadeUp 0.4s ease;
        }

        .spinner {
            width: 60px;
            height: 60px;
            border: 4px solid rgba(0, 255, 136, 0.1);
            border-left-color: var(--primary);
            border-radius: 50%;
            animation: spin 1s linear infinite;
            margin-bottom: 20px;
        }

        .stk-status-visual {
            width: min(100%, 360px);
            min-height: 106px;
            margin: -8px auto 4px;
            display: grid;
            place-items: center;
            overflow: hidden;
        }

        .stk-pending-visual,
        .stk-transfer-visual,
        .stk-success-visual,
        .stk-failure-visual {
            display: none;
            align-items: center;
            justify-content: center;
            width: 100%;
            min-height: 106px;
        }

        .stk-status-visual[data-state="pending"] .stk-pending-visual,
        .stk-status-visual[data-state="processing"] .stk-transfer-visual,
        .stk-status-visual[data-state="success"] .stk-success-visual,
        .stk-status-visual[data-state="failure"] .stk-failure-visual {
            display: flex;
        }

        .stk-orbit {
            position: relative;
            width: 74px;
            height: 74px;
            display: grid;
            place-items: center;
            border: 1px solid rgba(0, 225, 255, 0.22);
            border-radius: 50%;
            background: radial-gradient(circle, rgba(0, 225, 255, 0.11), rgba(0, 255, 136, 0.035) 65%, transparent 70%);
            box-shadow: 0 0 32px rgba(0, 225, 255, 0.1);
        }

        .stk-orbit-track {
            position: absolute;
            inset: 8px;
            border: 2px dashed rgba(0, 225, 255, 0.42);
            border-radius: 50%;
            animation: stk-orbit-rotate 2.2s linear infinite;
        }

        .stk-orbit-dot {
            position: absolute;
            top: 1px;
            left: 50%;
            width: 10px;
            height: 10px;
            transform: translateX(-50%);
            border-radius: 50%;
            background: #00e1ff;
            box-shadow: 0 0 14px rgba(0, 225, 255, 0.9);
        }

        .stk-orbit-core {
            z-index: 1;
            width: 48px;
            height: 48px;
            display: grid;
            place-items: center;
            border-radius: 14px;
            overflow: hidden;
            background: rgba(255, 255, 255, 0.96);
            box-shadow: 0 2px 12px rgba(0, 225, 255, 0.16);
        }

        .stk-orbit-core img {
            display: block;
            width: 100%;
            height: 100%;
            object-fit: contain;
        }

        .payment-sent-to {
            width: fit-content;
            max-width: 100%;
            margin: 0 auto 9px;
            padding: 6px 12px;
            border: 1px solid rgba(0, 225, 255, .2);
            border-radius: 999px;
            color: #0e7490;
            background: rgba(0, 225, 255, .07);
            font-size: 12px;
            font-weight: 700;
            overflow-wrap: anywhere;
        }

        .stk-transfer-visual {
            gap: clamp(10px, 4vw, 22px);
            padding: 0 8px;
        }

        .stk-transfer-node {
            z-index: 1;
            min-width: 65px;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 8px;
            color: #d9e6f4;
            font-size: 11px;
            font-weight: 600;
            white-space: nowrap;
        }

        .stk-transfer-node-icon {
            width: 48px;
            height: 48px;
            display: grid;
            place-items: center;
            border: 1px solid rgba(255, 255, 255, 0.12);
            border-radius: 16px;
            color: #9effd3;
            background: rgba(255, 255, 255, 0.055);
            box-shadow: 0 8px 22px rgba(0, 0, 0, 0.18);
        }

        .stk-transfer-node-icon svg {
            width: 23px;
            height: 23px;
        }

        .stk-transfer-track {
            position: relative;
            flex: 1;
            height: 3px;
            min-width: 50px;
            max-width: 126px;
            border-radius: 8px;
            background: linear-gradient(90deg, rgba(0, 225, 255, 0.2), rgba(0, 255, 136, 0.32));
        }

        .stk-transfer-track::after {
            content: "";
            position: absolute;
            top: 50%;
            right: -1px;
            width: 8px;
            height: 8px;
            border-top: 2px solid #70ffd0;
            border-right: 2px solid #70ffd0;
            transform: translateY(-50%) rotate(45deg);
        }

        .stk-money-token {
            position: absolute;
            top: 50%;
            left: 0;
            width: 24px;
            height: 24px;
            display: grid;
            place-items: center;
            border: 1px solid rgba(0, 255, 136, 0.7);
            border-radius: 50%;
            color: #041b14;
            background: #80ffc4;
            box-shadow: 0 0 18px rgba(0, 255, 136, 0.52);
            font-size: 12px;
            font-weight: 900;
            transform: translate(-50%, -50%);
            animation: stk-money-travel 1.35s ease-in-out infinite;
        }

        .stk-success-visual,
        .stk-failure-visual {
            position: relative;
        }

        .stk-result-icon {
            width: 78px;
            height: 78px;
            display: grid;
            place-items: center;
            border-radius: 50%;
        }

        .stk-result-icon svg {
            width: 42px;
            height: 42px;
        }

        .stk-success-visual .stk-result-icon {
            color: #052015;
            background: linear-gradient(145deg, #98ffd1, #24d88a);
            box-shadow: 0 0 38px rgba(0, 255, 136, 0.26);
            animation: stk-success-pop 650ms cubic-bezier(.18,.85,.25,1.25) both;
        }

        .stk-failure-visual .stk-result-icon {
            color: #fff;
            background: linear-gradient(145deg, #ff758a, #d9284d);
            box-shadow: 0 0 34px rgba(255, 51, 102, 0.22);
            animation: stk-failure-shake 450ms ease both;
        }

        .stk-confetti {
            position: absolute;
            inset: 8px 16%;
            pointer-events: none;
        }

        .stk-confetti i {
            position: absolute;
            top: 46%;
            left: 50%;
            width: 7px;
            height: 11px;
            border-radius: 2px;
            opacity: 0;
            background: var(--confetti-color, #00ff88);
            animation: stk-confetti-burst 850ms ease-out forwards;
            animation-delay: var(--confetti-delay, 0ms);
            transform: rotate(var(--confetti-rotation, 0deg));
        }

        .stk-confetti i:nth-child(1) { --confetti-x: -92px; --confetti-y: -42px; --confetti-color: #00e1ff; --confetti-rotation: 28deg; }
        .stk-confetti i:nth-child(2) { --confetti-x: -62px; --confetti-y: 46px; --confetti-color: #a8ffcf; --confetti-rotation: -32deg; --confetti-delay: 50ms; }
        .stk-confetti i:nth-child(3) { --confetti-x: -30px; --confetti-y: -64px; --confetti-color: #ffe16b; --confetti-rotation: 45deg; --confetti-delay: 90ms; }
        .stk-confetti i:nth-child(4) { --confetti-x: 33px; --confetti-y: -56px; --confetti-color: #4de3ff; --confetti-rotation: -18deg; --confetti-delay: 20ms; }
        .stk-confetti i:nth-child(5) { --confetti-x: 72px; --confetti-y: 43px; --confetti-color: #92ffb8; --confetti-rotation: 55deg; --confetti-delay: 80ms; }
        .stk-confetti i:nth-child(6) { --confetti-x: 100px; --confetti-y: -24px; --confetti-color: #ffd166; --confetti-rotation: -40deg; --confetti-delay: 120ms; }
        .stk-confetti i:nth-child(7) { --confetti-x: -106px; --confetti-y: 15px; --confetti-color: #b8a6ff; --confetti-rotation: 70deg; --confetti-delay: 140ms; }
        .stk-confetti i:nth-child(8) { --confetti-x: 8px; --confetti-y: 65px; --confetti-color: #ff8ac4; --confetti-rotation: -55deg; --confetti-delay: 40ms; }

        @keyframes stk-orbit-rotate { to { transform: rotate(360deg); } }
        @keyframes stk-money-travel {
            0% { left: 0; opacity: 0; transform: translate(-50%, -50%) scale(.72); }
            16%, 82% { opacity: 1; }
            100% { left: 100%; opacity: 0; transform: translate(-50%, -50%) scale(1.08); }
        }
        @keyframes stk-success-pop {
            0% { opacity: 0; transform: scale(.45) rotate(-12deg); }
            72% { opacity: 1; transform: scale(1.12) rotate(3deg); }
            100% { transform: scale(1) rotate(0); }
        }
        @keyframes stk-failure-shake {
            0%, 100% { transform: translateX(0); }
            25% { transform: translateX(-7px); }
            75% { transform: translateX(7px); }
        }
        @keyframes stk-confetti-burst {
            0% { opacity: 0; transform: translate(0, 0) scale(.5) rotate(0); }
            18% { opacity: 1; }
            100% { opacity: 0; transform: translate(var(--confetti-x), var(--confetti-y)) scale(1) rotate(180deg); }
        }

        .stk-progress-track {
            width: min(100%, 360px);
            height: 5px;
            margin: 0 auto 16px;
            overflow: hidden;
            border-radius: 99px;
            background: rgba(255, 255, 255, 0.09);
        }

        .stk-progress-fill {
            width: 36%;
            height: 100%;
            border-radius: inherit;
            background: linear-gradient(90deg, #00e1ff, #00ff88);
            box-shadow: 0 0 12px rgba(0, 225, 255, 0.34);
            animation: stk-progress-shimmer 1.6s ease-in-out infinite;
        }

        .stk-progress-fill[data-state="processing"] { width: 62%; }
        .stk-progress-fill[data-state="success"] {
            width: 100%;
            background: #24d88a;
            animation: none;
        }
        .stk-progress-fill[data-state="failure"] {
            width: 100%;
            background: #ff4e70;
            animation: none;
        }

        @keyframes stk-progress-shimmer {
            0% { transform: translateX(-110%); }
            100% { transform: translateX(290%); }
        }

        @media (max-width: 420px) {
            .stk-status-visual,
            .stk-pending-visual,
            .stk-transfer-visual,
            .stk-success-visual,
            .stk-failure-visual { min-height: 100px; }
            .stk-transfer-node { min-width: 58px; font-size: 10px; }
            .stk-transfer-node-icon { width: 43px; height: 43px; border-radius: 14px; }
            .stk-transfer-track { min-width: 32px; }
        }

        @media (prefers-reduced-motion: reduce) {
            .stk-orbit-track,
            .stk-money-token,
            .stk-success-visual .stk-result-icon,
            .stk-failure-visual .stk-result-icon,
            .stk-confetti i,
            .stk-progress-fill {
                animation-duration: 0.01ms !important;
                animation-iteration-count: 1 !important;
            }
        }

        @keyframes spin {
            100% { transform: rotate(360deg); }
        }

        .timer {
            font-size: 32px;
            font-weight: 700;
            margin: 10px 0;
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        /* Receipt */
        .receipt-container {
            display: none;
            flex-direction: column;
        }

        .receipt-card {
            background: linear-gradient(135deg, rgba(0, 255, 136, 0.1), rgba(0, 225, 255, 0.1));
            border-radius: 16px;
            padding: 24px;
            border: 1px solid rgba(0, 255, 136, 0.2);
            animation: fadeUp 0.5s ease;
        }

        .receipt-card.failed {
            background: linear-gradient(135deg, rgba(255, 51, 102, 0.1), rgba(204, 0, 51, 0.1));
            border-color: rgba(255, 51, 102, 0.2);
        }

        .receipt-header {
            text-align: center;
            margin-bottom: 20px;
            padding-bottom: 20px;
            border-bottom: 1px dashed rgba(255, 255, 255, 0.1);
        }

        .receipt-icon {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            background: var(--primary);
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 12px;
            font-size: 24px;
            color: #0f172a;
        }

        .receipt-card.failed .receipt-icon {
            background: var(--error);
        }

        .receipt-amount {
            font-size: 32px;
            font-weight: 700;
            color: #fff;
        }

        .receipt-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 12px;
            font-size: 14px;
        }

        .receipt-label { color: var(--text-muted); }
        .receipt-value { font-weight: 500; text-align: right; }

        @keyframes fadeUp {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            25% { transform: translateX(-5px); }
            50% { transform: translateX(5px); }
            75% { transform: translateX(-5px); }
        }

        .shake { animation: shake 0.4s ease-in-out; }

    
          
          /* Custom overrides for the new layout */
          body {
              background-color: #f8fafc;
              color: #1e293b;
              min-height: 100vh;
              display: block;
              overflow-y: auto;
          }
          
          .bg-animation {
              display: none;
          }
          
          .main-container {
              max-width: 28rem;
              margin: 0 auto;
              padding: 20px;
              padding-bottom: 80px;
          }
          
          /* Reset card styles from test.html */
          .card {
              background: #ffffff;
              backdrop-filter: none;
              -webkit-backdrop-filter: none;
              border: 1px solid #e2e8f0;
              box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05), 0 4px 6px -2px rgba(0, 0, 0, 0.02);
              padding: 20px;
              border-radius: 16px;
          }
          
          .input-group label {
              color: #475569;
          }
          
          .input-wrapper input, .custom-select {
              background: #f1f5f9;
              border: 1px solid #cbd5e1;
              color: #1e293b;
          }
          
          .custom-select option {
              background: #ffffff;
              color: #1e293b;
          }
          
          .header h1 {
              background: none;
              -webkit-text-fill-color: #1e293b;
              color: #1e293b;
          }
          
          .header p {
              color: #64748b;
          }
          
          .receipt-card {
              background: #f0fdf4;
              border-color: #bbf7d0;
          }
          
          .receipt-card.failed {
              background: #fef2f2;
              border-color: #fecaca;
          }
          
          .receipt-amount {
              color: #1e293b;
          }
          
          .receipt-label {
              color: #64748b;
          }
          
          .receipt-value {
              color: #1e293b;
          }
          
          /* Modal */
          .modal-overlay {
              background-color: rgba(0, 0, 0, 0.6);
              backdrop-filter: blur(4px);
          }

        /* Wallet-style approved loan card */
        .wallet-card {
            background:
                radial-gradient(circle at 88% 18%, rgba(255, 255, 255, 0.13) 0 1px, transparent 1.5px),
                linear-gradient(135deg, #174967 0%, #0e2f47 52%, #071c2e 100%) !important;
            background-size: 14px 14px, auto;
            border: 1px solid rgba(255, 255, 255, 0.18);
            border-radius: 20px 20px 14px 14px;
            box-shadow: 0 18px 36px rgba(5, 27, 43, 0.22), inset 0 1px 0 rgba(255, 255, 255, 0.13);
            min-height: 275px;
        }

        .wallet-card::after {
            content: '';
            position: absolute;
            left: 0;
            right: 0;
            bottom: 0;
            height: 7px;
            background: linear-gradient(90deg, #ff6b00, #ff9f43, #ff6b00);
            opacity: 0.9;
        }

        .wallet-card-topline {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 1.1rem;
            color: rgba(255, 255, 255, 0.72);
            font-size: 0.62rem;
            font-weight: 700;
            letter-spacing: 0.14em;
            text-transform: uppercase;
        }

        .wallet-chip {
            position: relative;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 35px;
            height: 25px;
            border-radius: 6px;
            background: linear-gradient(135deg, #f9d77e, #b7832f);
            box-shadow: inset 0 1px 2px rgba(255, 255, 255, 0.55), 0 3px 8px rgba(0, 0, 0, 0.18);
        }

        .wallet-chip::before,
        .wallet-chip::after {
            content: '';
            position: absolute;
            width: 18px;
            height: 11px;
            border: 1px solid rgba(81, 54, 12, 0.55);
            border-radius: 4px;
        }

        .wallet-chip::after {
            width: 1px;
            height: 23px;
            border: 0;
            border-left: 1px solid rgba(81, 54, 12, 0.55);
        }

        .wallet-contactless {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            color: rgba(255, 255, 255, 0.7);
        }

        .wallet-contactless svg {
            width: 15px;
            height: 15px;
        }

        .confirm-agreement-btn {
            width: 100%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            margin: 0 0 14px;
            padding: 10px 12px;
            color: var(--primary-blue);
            background: #f8fafc;
            border: 1px solid #cbd5e1;
            border-radius: 10px;
            font-size: 13px;
            font-weight: 700;
            cursor: pointer;
            transition: background 0.2s, border-color 0.2s;
        }

        .confirm-agreement-btn:hover {
            background: #eff6ff;
            border-color: #93c5fd;
        }

        .agreement-overlay {
            position: fixed;
            inset: 0;
            z-index: 250;
            display: flex;
            align-items: flex-end;
            justify-content: center;
            padding: 0;
            background: rgba(0, 0, 0, 0.62);
            backdrop-filter: blur(4px);
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.25s ease;
        }

        .agreement-overlay.open {
            opacity: 1;
            pointer-events: auto;
        }

        .agreement-sheet {
            width: 100%;
            max-width: 480px;
            max-height: 88vh;
            overflow-y: auto;
            padding: 18px 18px 28px;
            background: #fff;
            border-radius: 22px 22px 0 0;
            transform: translateY(100%);
            transition: transform 0.3s ease;
        }

        .agreement-overlay.open .agreement-sheet {
            transform: translateY(0);
        }

        .agreement-handle {
            width: 38px;
            height: 4px;
            margin: 0 auto 16px;
            background: #d1d5db;
            border-radius: 2px;
        }

        .agreement-sheet h2 {
            margin: 14px 0 5px;
            padding-bottom: 4px;
            border-bottom: 1px solid #e5e7eb;
            color: var(--primary-blue);
            font-size: 11px;
            font-weight: 800;
            letter-spacing: 0.06em;
            text-transform: uppercase;
        }

        .agreement-table {
            width: 100%;
            border-collapse: collapse;
            color: #374151;
            font-size: 12px;
        }

        .agreement-table td {
            padding: 6px 0;
            border-bottom: 1px solid #f1f5f9;
        }

        .agreement-table td:last-child {
            color: #111827;
            font-weight: 700;
            text-align: right;
        }

        .agreement-copy {
            color: #4b5563;
            font-size: 12px;
            line-height: 1.65;
        }

        .agreement-close-btn {
            width: 100%;
            margin-top: 16px;
            padding: 12px;
            color: #fff;
            background: var(--primary-blue);
            border: 0;
            border-radius: 10px;
            font-weight: 700;
            cursor: pointer;
        }
      </style>
  </head>
  <body>
      <header>
          
        <div class="header-content">
            <div class="logo-section">
                <img src="swiftloan-logo.png" alt="Swift Loan Limited Logo" class="logo-img">
                <div class="logo-text-container">
                    <div class="logo-main">Swift <span>Loan</span> Limited</div>
                    <div class="logo-tagline">EMPOWERING BUSINESS THROUGH FINANCE</div>
                </div>
            
              </div>
              <div class="flex items-center mx-4">
                  <div class="savings-box" aria-label="Savings balance">
                      <span class="savings-label">Savings</span>
                      <span class="savings-value" id="headerBalance">ZMW 0.00</span>
                  </div>
              </div>
              <div class="header-actions">
                <button class="icon-btn" id="notificationBtn" title="Notifications">
                    <svg viewBox="0 0 24 24">
                        <path d="M12,22A2,2 0 0,1 10,20H14A2,2 0 0,1 12,22M18,16V11C18,7.93 16.36,5.36 13.5,4.68V4A1.5,1.5 0 0,0 12,2.5A1.5,1.5 0 0,0 10.5,4V4.68C7.63,5.36 6,7.92 6,11V16L4,18V19H20V18L18,16M12,6A5,5 0 0,1 17,11V17H7V11A5,5 0 0,1 12,6Z"/>
                    </svg>
                    <span class="notification-dot-new" id="notificationDot"></span>
                </button>
                <div class="hamburger" id="hamburger">
                    <span></span>
                    <span></span>
                    <span></span>
                </div>
            </div>
        </div>
    
      </header>
      
      <!-- Notification Dropdown -->
    <div class="notification-dropdown" id="notificationDropdown">
        <div class="notification-header">
            <h3>Notifications</h3>
            <button class="mark-read-btn" id="markAllReadBtn">Mark all read</button>
        </div>
        <div id="notificationList">
            <div class="notification-item" id="notification1">
                <div class="notification-item-header">
                    <span class="notification-title">Welcome to Swift Loan!</span>
                    <span class="notification-time">Just now</span>
                </div>
                <p class="notification-message">
                    Get started with your first loan today! Apply now and access instant funds via Mobile Money.
                </p>
            </div>
        </div>
    </div>

    <!-- Sidebar Menu -->
    
      <div class="overlay" id="overlay"></div>
    <aside class="sidebar" id="sidebar">
        <div class="sidebar-header">
            <div class="sidebar-logo">Menu</div>
            <button class="close-btn" id="closeSidebar">&times;</button>
        </div>
        <ul class="sidebar-menu">
            <li><a href="index.html">Home</a></li>
