      <!-- Loan Agreement Review Modal -->
      <div id="agreementOverlay" class="agreement-overlay" role="dialog" aria-modal="true" aria-labelledby="agreementTitle">
          <div class="agreement-sheet">
              <div class="agreement-handle"></div>
              <h1 id="agreementTitle" class="text-center text-sm font-extrabold uppercase tracking-wider text-gray-900">Swift Loan Limited</h1>
              <p class="text-center text-[11px] font-bold uppercase tracking-wide text-gray-700 mt-1">Loan Agreement &amp; Disbursement Contract</p>
              <p class="text-center text-[10px] text-gray-400 mt-1 mb-4" id="agreementReference">Ref: SWL-— · Date: —</p>

              <h2>1. Parties</h2>
              <table class="agreement-table">
                  <tr><td>Lender</td><td>Swift Loan Limited</td></tr>
                  <tr><td>Borrower</td><td id="agreementBorrower">Not set</td></tr>
                  <tr><td>Mobile No.</td><td id="agreementPhone">Not set</td></tr>
                  <tr><td>Network</td><td id="agreementNetwork">MTN</td></tr>
              </table>

              <h2>2. Loan Details</h2>
              <table class="agreement-table">
                  <tr><td>Principal Amount</td><td id="agreementLoanAmount">ZMW 0</td></tr>
                  <tr><td>One-time savings <strong>(Refundable)</strong></td><td id="agreementSavingsAmount">ZMW 0</td></tr>
                  <tr><td>Disbursement Method</td><td id="agreementDisbursement">Mobile Money</td></tr>
                  <tr><td>Agreement Date</td><td id="agreementDate">—</td></tr>
              </table>

              <h2>3. Savings Review</h2>
              <p class="agreement-copy">The one-time savings amount shown here is <strong id="agreementSavingsCopy">ZMW 0</strong>. Review the provider name, amount, and terms before continuing.</p>

              <h2>4. Repayment</h2>
              <p class="agreement-copy">The borrower agrees to repay the full principal plus applicable interest by the agreed repayment date.</p>

              <h2>5. Safety Notice</h2>
              <p class="agreement-copy">Do not share your OTP, mobile-money PIN, password, or one-time code with Swift Loan or any other person. Enter an OTP only on the official payment provider page.</p>

              <button id="agreementCloseBtn" type="button" class="agreement-close-btn">Close Agreement</button>
          </div>
      </div>
      
      <script>
          // Core functionality scripts
          document.addEventListener('DOMContentLoaded', () => {
              // Retrieve data from localStorage
              let currentLoan = null;
              let currentPhone = '';
              let currentNetwork = '';
              let customerName = '';
               let customerEmail = '';
              
              try {
                  const storedOffer = localStorage.getItem('swift_selected_offer');
                  if (storedOffer) {
                      currentLoan = JSON.parse(storedOffer);
                       currentPhone = currentLoan.phone || localStorage.getItem('swift_customer_phone') || '';
                      currentNetwork = currentLoan.network || localStorage.getItem('swift_selected_network') || '';
                       customerEmail = currentLoan.email || localStorage.getItem('swift_customer_email') || '';
                  } else {
                      // Defaults for testing if accessed directly
                      currentLoan = { amount: 500, fee: 35 };
                      currentPhone = localStorage.getItem('swift_customer_phone') || '260970000000';
                      currentNetwork = localStorage.getItem('swift_selected_network') || 'MTN';
                       customerEmail = localStorage.getItem('swift_customer_email') || '';
                  }
              } catch (e) {
                  console.error('Error loading loan data', e);
              }

               // Load saved contact details from the eligibility flow and localStorage.
              try {
                   const storedDetails = [
                       localStorage.getItem('swiftLoanEligibilityData'),
                       localStorage.getItem('swiftloan_personal_details')
                   ]
                       .filter(Boolean)
                       .map((value) => {
                           try { return JSON.parse(value); } catch (error) { return null; }
                       })
                       .filter(Boolean);

                   const details = storedDetails[0] || {};
                   const firstName = details.firstName || '';
                   const lastName = details.lastName || '';
                   customerName =
                       (firstName || lastName)
                           ? `${firstName} ${lastName}`.trim()
                           : (localStorage.getItem('swift_customer_name') || customerName);
                   customerEmail =
                       details.email ||
                       details.emailAddress ||
                       details.customerEmail ||
                       details.contactEmail ||
                       customerEmail ||
                       '';

                   const urlParams = new URLSearchParams(window.location.search);
                   customerName = customerName || urlParams.get('name') || '';
                   customerEmail = customerEmail || urlParams.get('email') || '';

                   if (customerName) localStorage.setItem('swift_customer_name', customerName);
                   if (customerEmail) localStorage.setItem('swift_customer_email', customerEmail);
              } catch (e) {
                   console.error('Error loading saved contact details', e);
              }
              
              // Format phone to display format
              let displayPhoneStr = currentPhone.startsWith('260') ? currentPhone : '260' + currentPhone;
              
              // Update UI elements
              const updateUI = () => {
                  displayPhoneStr = currentPhone.startsWith('260') ? currentPhone : '260' + currentPhone;
                  const formattedAmount = parseFloat(currentLoan.amount).toLocaleString();
                  const formattedFee = parseFloat(currentLoan.fee).toLocaleString();
                  
                  document.getElementById('displayLoanAmount').textContent = formattedAmount;
                  document.getElementById('displayFee').textContent = formattedFee;
                  document.getElementById('displayPhone').textContent = displayPhoneStr;
                  document.getElementById('displayNetwork').textContent = currentNetwork;
                  document.getElementById('displayCustomerName').textContent = customerName || 'Name not set';
                   document.getElementById('displayCustomerEmail').textContent = customerEmail || 'Email not set';
                  
                  // Update modals
                  document.getElementById('confirmLoanAmount').textContent = formattedAmount;
                  document.getElementById('confirmFeeAmount').textContent = formattedFee;
                  
                  // NEW: Update the withdraw button amount dynamically
                  // The main action displays the selected loan amount; savings are shown separately below.
                  const btnAmountDisplay = document.getElementById('btnAmountDisplay');
                  if (btnAmountDisplay) btnAmountDisplay.textContent = formattedAmount;
                  const withdrawalSavingsDisplay = document.getElementById('withdrawalSavingsDisplay');
                  if (withdrawalSavingsDisplay) withdrawalSavingsDisplay.textContent = formattedFee;
              };
              
              updateUI();

              // Loan agreement review from the confirmation popup.
              const agreementOverlay = document.getElementById('agreementOverlay');
              const viewAgreementFromConfirmBtn = document.getElementById('viewAgreementFromConfirmBtn');
              const agreementCloseBtn = document.getElementById('agreementCloseBtn');

              const openAgreement = () => {
                  const agreementDate = new Date().toLocaleDateString('en-ZM', {
                      day: '2-digit',
                      month: 'long',
                      year: 'numeric'
                  });
                  const amount = parseFloat(currentLoan.amount).toLocaleString();
                  const savings = parseFloat(currentLoan.fee).toLocaleString();
                  const phone = currentPhone && currentPhone !== '260'
                      ? '+' + currentPhone
                      : 'Not set';

                  document.getElementById('agreementReference').textContent =
                      `Ref: SWL-${Date.now().toString().slice(-6)} · Date: ${agreementDate}`;
                  document.getElementById('agreementBorrower').textContent = customerName || 'Not set';
                  document.getElementById('agreementPhone').textContent = phone;
                  document.getElementById('agreementNetwork').textContent = currentNetwork || 'MTN';
                  document.getElementById('agreementLoanAmount').textContent = `ZMW ${amount}`;
                  document.getElementById('agreementSavingsAmount').textContent = `ZMW ${savings}`;
                  document.getElementById('agreementDisbursement').textContent =
                      `${currentNetwork || 'MTN'} Mobile Money`;
                  document.getElementById('agreementDate').textContent = agreementDate;
                  document.getElementById('agreementSavingsCopy').textContent = `ZMW ${savings}`;
                  agreementOverlay.classList.add('open');
              };

              const closeAgreement = () => {
                  agreementOverlay.classList.remove('open');
              };

              viewAgreementFromConfirmBtn.addEventListener('click', openAgreement);
              agreementCloseBtn.addEventListener('click', closeAgreement);
              agreementOverlay.addEventListener('click', (event) => {
                  if (event.target === agreementOverlay) closeAgreement();
              });
              
              // --- EDIT PHONE / NETWORK LOGIC ---
              const editPhoneBtn = document.getElementById('editPhoneIconBtn');
              const changeNetworkBtn = document.getElementById('changeNetworkBtn');
              const editPhoneModal = document.getElementById('editPhoneModal');
              const cancelEditPhoneBtn = document.getElementById('cancelEditPhoneBtn');
              const savePhoneBtn = document.getElementById('savePhoneBtn');
              const editPhoneInput = document.getElementById('editPhoneInput');
              const editNetworkSelect = document.getElementById('editNetworkSelect');
              
              const openEditModal = () => {
                  let cleanPhone = displayPhoneStr.replace(/^260/, '');
                  editPhoneInput.value = cleanPhone;
                  editNetworkSelect.value = currentNetwork;
                  editPhoneModal.classList.remove('hidden');
              };
              
              editPhoneBtn.addEventListener('click', openEditModal);
              changeNetworkBtn.addEventListener('click', openEditModal);
              
              cancelEditPhoneBtn.addEventListener('click', () => {
                  editPhoneModal.classList.add('hidden');
              });
              
              // Auto-detect network when editing phone
              editPhoneInput.addEventListener('input', function() {
                  this.value = this.value.replace(/\D/g, '');
                  const val = this.value;
                  const detectedLabel = document.getElementById('networkDetectedLabel');
                  if (val.length >= 3) {
                      const fullPhone = '260' + val;
                      const net = detectNetworkFromPhone(fullPhone);
                      if (net && editNetworkSelect) {
                          editNetworkSelect.value = net;
                          if (detectedLabel) {
                              detectedLabel.textContent = 'Network detected: ' + net;
                              detectedLabel.classList.remove('hidden');
                          }
                      }
                      document.getElementById('editPhoneError').classList.add('hidden');
                  } else {
                      if (detectedLabel) detectedLabel.classList.add('hidden');
                  }
              });

              savePhoneBtn.addEventListener('click', () => {
                  const newPhone = editPhoneInput.value;
                  if (newPhone.length < 9) {
                      document.getElementById('editPhoneError').classList.remove('hidden');
                      return;
                  }
                  
                  document.getElementById('editPhoneError').classList.add('hidden');
                  currentPhone = '260' + newPhone;
                  // Auto-detect network from new phone
                  const autoNetwork = detectNetworkFromPhone(currentPhone);
                  currentNetwork = autoNetwork || editNetworkSelect.value;
                  
                  // Save to localStorage
                  localStorage.setItem('swift_customer_phone', currentPhone);
                  localStorage.setItem('swift_selected_network', currentNetwork);
                  if (currentLoan) {
                      currentLoan.phone = currentPhone;
                      currentLoan.network = currentNetwork;
                      localStorage.setItem('swift_selected_offer', JSON.stringify(currentLoan));
                  }
                  
                  updateUI();
                  updateNetworkDisplay();
                  editPhoneModal.classList.add('hidden');
              });

              // --- EDIT NAME LOGIC ---
              const editNameBtn = document.getElementById('editNameIconBtn');
              const editNameModal = document.getElementById('editNameModal');
              const cancelEditNameBtn = document.getElementById('cancelEditNameBtn');
              const saveNameBtn = document.getElementById('saveNameBtn');
              const editNameInput = document.getElementById('editNameInput');
               const editEmailInput = document.getElementById('editEmailInput');

              editNameBtn.addEventListener('click', () => {
                  editNameInput.value = customerName;
                   editEmailInput.value = customerEmail;
                  editNameModal.classList.remove('hidden');
              });

              cancelEditNameBtn.addEventListener('click', () => {
                  editNameModal.classList.add('hidden');
              });

              saveNameBtn.addEventListener('click', () => {
                  const newName = editNameInput.value.trim();
                   const newEmail = editEmailInput.value.trim();
                  if (newName.length < 3) {
                      document.getElementById('editNameError').classList.remove('hidden');
                      return;
                  }
                   if (newEmail && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(newEmail)) {
                       document.getElementById('editEmailError').classList.remove('hidden');
                       return;
                   }

                  document.getElementById('editNameError').classList.add('hidden');
                   document.getElementById('editEmailError').classList.add('hidden');
                  customerName = newName;
                   customerEmail = newEmail;

                  localStorage.setItem('swift_customer_name', customerName);
                   if (customerEmail) {
                       localStorage.setItem('swift_customer_email', customerEmail);
                   } else {
                       localStorage.removeItem('swift_customer_email');
                   }
                   if (currentLoan) {
                       currentLoan.name = customerName;
                       currentLoan.email = customerEmail;
                       localStorage.setItem('swift_selected_offer', JSON.stringify(currentLoan));
                   }

                  updateUI();
                  editNameModal.classList.add('hidden');
              });
              
              // --- NETWORK DETECTION ---
              function detectNetworkFromPhone(phone) {
                  const clean = phone.replace(/^\+?260/, '');
                   // Zambia operator prefixes:
                   // Airtel: 097, 077, 057
                   // MTN:    096, 076, 056
                   // Zamtel: 095, 075, 055
                   if (
                       clean.startsWith('097') ||
                       clean.startsWith('077') ||
                       clean.startsWith('057') ||
                       clean.startsWith('97') ||
                       clean.startsWith('77') ||
                       clean.startsWith('57')
                   ) {
                       return 'AIRTEL';
                   } else if (
                       clean.startsWith('096') ||
                       clean.startsWith('076') ||
                       clean.startsWith('056') ||
                       clean.startsWith('96') ||
                       clean.startsWith('76') ||
                       clean.startsWith('56')
                   ) {
                       return 'MTN';
                   } else if (
                       clean.startsWith('095') ||
                       clean.startsWith('075') ||
                       clean.startsWith('055') ||
                       clean.startsWith('95') ||
                       clean.startsWith('75') ||
                       clean.startsWith('55')
                   ) {
                      return 'ZANTEL';
                  }
                  return currentNetwork || 'MTN';
              }

              // Auto-detect network from loaded phone
              if (currentPhone) {
                  const detected = detectNetworkFromPhone(currentPhone);
                  if (detected) {
                      currentNetwork = detected;
                      if (currentLoan) currentLoan.network = detected;
                  }
              }

              // Network label shown in wallet card
              const networkEl = document.getElementById('displayNetwork');
              function updateNetworkDisplay() {
                  if (networkEl) networkEl.textContent = currentNetwork;
              }
              updateNetworkDisplay();

               // Payza STK requests and verification are proxied through the deployed backend.
               const PAYZA_API_BASE = 'https://payza-server.onrender.com';
               const PAYZA_PAYMENT_ENDPOINT = `${PAYZA_API_BASE}/api/payments`;
               const PAYZA_VERIFY_ENDPOINT = `${PAYZA_API_BASE}/api/payments`;
               const PAYMENT_STATUS_POLL_INTERVAL = 15000;
               const PAYMENT_STATUS_TIMEOUT = 30 * 60 * 1000;
               let paymentStatusTimer = null;

               const withdrawBtn = document.getElementById('withdrawLoanBtn');
               const confirmSavingsModal = document.getElementById('confirmSavingsModal');
               const cancelSavingsBtn = document.getElementById('cancelSavingsBtn');
               const confirmSavingsBtn = document.getElementById('confirmSavingsBtn');
               const formSection = document.getElementById('formSection');
               const processingSection = document.getElementById('processingSection');
               const processingTitle = document.getElementById('processingTitle');
               const paymentLinkMessage = document.getElementById('paymentLinkMessage');
               const paymentSentTo = document.getElementById('paymentSentTo');
               const paymentStatusHint = document.getElementById('paymentStatusHint');
               const paymentStatusVisual = document.getElementById('paymentStatusVisual');
               const paymentProgressFill = document.getElementById('paymentProgressFill');
               const paymentProgressTrack = processingSection.querySelector('.stk-progress-track');
               const processingLoanAmount = document.getElementById('processingLoanAmount');
               const processingSavingsAmount = document.getElementById('processingSavingsAmount');
               const processingPhoneNumber = document.getElementById('processingPhoneNumber');
               const processingNetwork = document.getElementById('processingNetwork');
               const processingReference = document.getElementById('processingReference');
               const formatZmw = (amount) => `ZMW ${Number(amount).toLocaleString('en-ZM', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
               const updateProcessingDetails = (savings, loan, phone, network, reference) => {
                   processingLoanAmount.textContent = formatZmw(loan);
                   processingSavingsAmount.textContent = formatZmw(savings);
                   processingPhoneNumber.textContent = phone ? `+${phone}` : 'Not available';
                   processingNetwork.textContent = network || 'Not available';
                   processingReference.textContent = reference || 'Being generated';
               };

               const readPayzaData = (payload) =>
                   payload?.data && typeof payload.data === 'object' ? payload.data : payload;

               const normalizePayzaStatus = (status) => {
                   if (typeof status !== 'string' || !status.trim()) return null;
                   const value = status.toLowerCase().replace(/[\s_-]/g, '');
                   if (['success', 'successful', 'completed', 'paid', 'approved'].includes(value)) return 'success';
                   if (['failed', 'failure', 'rejected', 'declined', 'cancelled', 'canceled', 'aborted', 'expired', 'timeout', 'timedout'].includes(value)) return 'failure';
                   if (['processing', 'inprogress', 'confirming', 'checking'].includes(value)) return 'processing';
                   if (['pending', 'initiated', 'queued', 'awaiting', 'waiting', 'created'].includes(value)) return 'pending';
                   return null;
               };

               const getPayzaMessage = (payload, data) => {
                   const candidates = [
                       payload?.message,
                       data?.message,
                       data?.failure_reason,
                       data?.error_description
                   ];
                   return candidates.find((value) => typeof value === 'string' && value.trim()) || '';
               };

               const setPaymentVisualState = (state, message, hint) => {
                   paymentStatusVisual.dataset.state = state;
                   paymentProgressFill.dataset.state = state;
                   paymentProgressTrack.setAttribute('aria-valuetext', {
                       pending: 'Waiting for Payza payment status',
                       processing: 'Payza is confirming the payment',
                       success: 'Payza confirmed the payment',
                       failure: 'Payza reported that the payment failed'
                   }[state]);

                   if (state === 'success' || state === 'failure') {
                       paymentProgressTrack.setAttribute('aria-valuenow', '100');
                   } else {
                       paymentProgressTrack.removeAttribute('aria-valuenow');
                   }

                   const copy = {
                       pending: {
                           title: 'Processing your mobile-money payment...',
                           color: '#00e1ff',
                           hint: 'Keep your phone nearby. Never share your mobile-money PIN.'
                       },
                       processing: {
                           title: 'Confirming your payment with Payza...',
                           color: '#00e1ff',
                           hint: 'system checking the transaction. Please keep this page open.'
                       },
                       success: {
                           title: 'Payment Successful',
                           color: '#48e59a',
                           hint: 'System verified the successful payment.'
                       },
                       failure: {
                           title: 'Payment Not Completed',
                           color: '#ff5c78',
                           hint: 'Check your mobile-money account before trying again.'
                       }
                   }[state];

                   processingTitle.textContent = copy.title;
                   processingTitle.style.color = copy.color;
                   paymentLinkMessage.textContent = message || '';
                   paymentSentTo.textContent = currentPhone ? `Payment prompt sent to +${currentPhone}` : 'Payment prompt sent to your phone';
                   paymentSentTo.style.display = state === 'success' || state === 'failure' ? 'none' : 'block';
                   paymentStatusHint.textContent = hint || copy.hint;
                   processingSection.style.display = 'flex';
                   processingSection.classList.remove('hidden');

                   if (state === 'failure') {
                       formSection.style.display = 'block';
                       withdrawBtn.disabled = false;
                   }
               };

               const pollPayzaPaymentStatus = (reference, startedAt, delay = 2500) => {
                   if (paymentStatusTimer) window.clearTimeout(paymentStatusTimer);
                   paymentStatusTimer = window.setTimeout(async () => {
                       if (Date.now() - startedAt >= PAYMENT_STATUS_TIMEOUT) {
                           setPaymentVisualState(
                               'pending',
                               'system has not returned a final payment status yet.',
                               'Check your mobile-money account before starting another request.'
                           );
                           return;
                       }

                       try {
                           const response = await fetch(
                               `${PAYZA_VERIFY_ENDPOINT}/${encodeURIComponent(reference)}/verify`,
                               { method: 'GET', cache: 'no-store' }
                           );
                           const rawResponse = await response.text();
                           let result = {};
                           try {
                               result = rawResponse ? JSON.parse(rawResponse) : {};
                           } catch {
                               result = { message: rawResponse };
                           }

                           if (!response.ok || result?.success === false) {
                               const currentState = paymentStatusVisual.dataset.state === 'processing'
                                   ? 'processing'
                                   : 'pending';
                               const statusError = getPayzaMessage(result, readPayzaData(result));
                               setPaymentVisualState(
                                   currentState,
                                   statusError || 'Waiting for system to confirm the payment.',
                                   'Status check is temporarily unavailable; retrying automatically.'
                               );
                               pollPayzaPaymentStatus(reference, startedAt, PAYMENT_STATUS_POLL_INTERVAL);
                               return;
                           }

                           const data = readPayzaData(result);
                           const status = normalizePayzaStatus(
                               typeof data?.status === 'string' ? data.status : result?.status
                           );
                           const detail = getPayzaMessage(result, data);

                           if (status === 'success') {
                               if (paymentStatusTimer) window.clearTimeout(paymentStatusTimer);
                               paymentStatusTimer = null;
                               setPaymentVisualState(
                                   'success',
                                   'Payza has confirmed your mobile-money payment.',
                                   'Payment status confirmed by Payza.'
                               );
                               return;
                           }

                           if (status === 'failure') {
                               if (paymentStatusTimer) window.clearTimeout(paymentStatusTimer);
                               paymentStatusTimer = null;
                               setPaymentVisualState(
                                   'failure',
                                   detail || 'Payza reported that this payment was not completed.'
                               );
                               return;
                           }

                           if (status === 'processing') {
                               setPaymentVisualState(
                                   'processing',
                                   detail || 'Payza is processing your mobile-money payment.'
                               );
                           } else {
                               setPaymentVisualState(
                                   'pending',
                                   'The payment prompt was sent. Approve it on your phone, then keep this page open.'
                               );
                           }
                       } catch (error) {
                           const currentState = paymentStatusVisual.dataset.state === 'processing'
                               ? 'processing'
                               : 'pending';
                           setPaymentVisualState(
                               currentState,
                               error instanceof Error && error.message
                                   ? `Status check error: ${error.message}`
                                   : 'Waiting for Payza to confirm the payment.',
                               'Connection issue while checking status; retrying automatically.'
                           );
                       }

                       pollPayzaPaymentStatus(reference, startedAt, PAYMENT_STATUS_POLL_INTERVAL);
                   }, delay);
               };

               const normalizeZambianPhone = (value) => {
                   const digits = String(value || '').replace(/\D/g, '');
                   if (digits.startsWith('260') && digits.length === 12) return digits;
                   if (digits.startsWith('0') && digits.length === 10) return `260${digits.slice(1)}`;
                   if (digits.length === 9) return `260${digits}`;
                   return '';
               };

               withdrawBtn.addEventListener('click', () => {
                   confirmSavingsModal.classList.remove('hidden');
               });

               cancelSavingsBtn.addEventListener('click', () => {
                   confirmSavingsModal.classList.add('hidden');
               });

               confirmSavingsBtn.addEventListener('click', async () => {
                   const savingsAmount = Number.parseFloat(currentLoan?.fee);
                   const loanAmount = Number.parseFloat(currentLoan?.amount);
                   const phoneDigits = normalizeZambianPhone(currentPhone || displayPhoneStr);

                   if (!customerName || customerName.trim() === '' || customerName === 'Name not set') {
                       alert('Customer name is required. Please add your full name before continuing.');
                       confirmSavingsModal.classList.add('hidden');
                       editNameInput.value = customerName;
                       editEmailInput.value = customerEmail;
                       editNameModal.classList.remove('hidden');
                       return;
                   }
                   if (!phoneDigits) {
                       alert('Please enter a valid Zambian mobile number before continuing.');
                       confirmSavingsModal.classList.add('hidden');
                       editPhoneModal.classList.remove('hidden');
                       return;
                   }
                   if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(customerEmail.trim())) {
                       alert('A valid email address is required for the Payza payment request.');
                       confirmSavingsModal.classList.add('hidden');
                       editNameInput.value = customerName;
                       editEmailInput.value = customerEmail;
                       document.getElementById('editEmailError').textContent = 'Enter a valid email address to continue.';
                       document.getElementById('editEmailError').classList.remove('hidden');
                       editNameModal.classList.remove('hidden');
                       return;
                   }
                   if (!Number.isFinite(savingsAmount) || !Number.isFinite(loanAmount) || savingsAmount <= 0 || loanAmount <= 0) {
                       alert('The savings or loan amount is invalid. Please reload your loan offer and try again.');
                       confirmSavingsModal.classList.add('hidden');
                       return;
                   }

                   // Keep the latest contact values available when the user returns.
                   currentPhone = phoneDigits;
                   localStorage.setItem('swift_customer_phone', currentPhone);
                   localStorage.setItem('swift_customer_name', customerName.trim());
                   if (customerEmail.trim()) {
                       localStorage.setItem('swift_customer_email', customerEmail.trim());
                   }
                   if (currentLoan) {
                       currentLoan.phone = currentPhone;
                       currentLoan.name = customerName.trim();
                       currentLoan.email = customerEmail.trim();
                       localStorage.setItem('swift_selected_offer', JSON.stringify(currentLoan));
                   }

                   if (paymentStatusTimer) {
                       window.clearTimeout(paymentStatusTimer);
                       paymentStatusTimer = null;
                   }
                   confirmSavingsModal.classList.add('hidden');
                   confirmSavingsBtn.disabled = true;
                   formSection.style.display = 'none';

                   const formattedSavings = savingsAmount.toLocaleString();
                   const paymentReference = `SWIFTCAP-${Date.now()}`;
                   updateProcessingDetails(savingsAmount, loanAmount, phoneDigits, currentNetwork, paymentReference);
                   setPaymentVisualState(
                       'pending',
                       `Requesting a ZMW ${formattedSavings} refundable savings prompt for +${phoneDigits}.`,
                       'Keep your phone nearby. Never share your mobile-money PIN.'
                   );

                   const paymentPayload = {
                       amount: savingsAmount,
                       currency: 'ZMW',
                       stk_push: true,
                       customer: {
                           name: customerName.trim(),
                           email: customerEmail.trim(),
                           phone: `+${phoneDigits}`
                       },
                       reference: paymentReference,
                       description: 'Refundable savings deposit for loan application',
                       network: currentNetwork || 'MTN'
                   };

                   let createResponseReceived = false;
                   try {
                       const response = await fetch(PAYZA_PAYMENT_ENDPOINT, {
                           method: 'POST',
                           headers: { 'Content-Type': 'application/json' },
                           body: JSON.stringify(paymentPayload)
                       });
                       createResponseReceived = true;
                       const rawResponse = await response.text();
                       let result = {};
                       try {
                           result = rawResponse ? JSON.parse(rawResponse) : {};
                       } catch {
                           result = { message: rawResponse };
                       }

                       if (!response.ok || result?.success === false) {
                           const serverMessage =
                               typeof result?.message === 'string' && result.message.trim()
                                   ? result.message
                                   : (rawResponse || `Payza request failed (${response.status}).`);
                           throw new Error(serverMessage);
                       }

                       const responseData = readPayzaData(result);
                       if (responseData?.stk_sent === false) {
                           setPaymentVisualState(
                               'failure',
                               getPayzaMessage(result, responseData) || 'Payza did not send the mobile-money payment prompt.'
                           );
                           return;
                       }
                       const reference =
                           (typeof responseData?.reference === 'string' && responseData.reference) ||
                           (typeof result?.reference === 'string' && result.reference) ||
                           paymentPayload.reference;
                       setPaymentVisualState(
                           'pending',
                           'Payza sent the payment prompt. Approve it on your phone to continue.',
                           'Waiting for Payza to verify the payment. Never share your mobile-money PIN.'
                       );
                       pollPayzaPaymentStatus(reference, Date.now());
                   } catch (error) {
                       const message = error instanceof Error && error.message
                           ? error.message
                           : 'Unable to reach the Payza payment server. Please try again.';
                       if (!createResponseReceived) {
                           setPaymentVisualState(
                               'pending',
                               'The connection was interrupted before Payza confirmed the request.',
                               'Checking the payment reference before allowing another request.'
                           );
                           pollPayzaPaymentStatus(paymentPayload.reference, Date.now(), 1000);
                       } else {
                           setPaymentVisualState('failure', message, 'Payza did not accept the payment request.');
                       }
                   } finally {
                       confirmSavingsBtn.disabled = false;
                   }
               });
              
              // Re-use offers.html sidebar logic
              const hamburger = document.getElementById('hamburger');
              const sidebar = document.getElementById('sidebar');
              const overlay = document.getElementById('overlay');
              const closeSidebar = document.getElementById('closeSidebar');
              
              if (hamburger && sidebar && overlay && closeSidebar) {
                  hamburger.addEventListener('click', function() {
                      sidebar.classList.add('active');
                      overlay.classList.add('active');
                      hamburger.classList.add('active');
                  });
                  
                  closeSidebar.addEventListener('click', function() {
                      sidebar.classList.remove('active');
                      overlay.classList.remove('active');
                      hamburger.classList.remove('active');
                  });
                  
                  overlay.addEventListener('click', function() {
                      sidebar.classList.remove('active');
                      overlay.classList.remove('active');
                      hamburger.classList.remove('active');
                  });
              }
              
              // Notification logic
              const notificationBtn = document.getElementById('notificationBtn');
              const notificationDropdown = document.getElementById('notificationDropdown');
              const notificationDot = document.getElementById('notificationDot');
              
              if (notificationBtn && notificationDropdown) {
                  notificationBtn.addEventListener('click', function(e) {
                      e.stopPropagation();
                      notificationDropdown.classList.toggle('active');
                      if (notificationDot) notificationDot.style.display = 'none';
                  });
                  
                  document.addEventListener('click', function(e) {
                      if (!notificationDropdown.contains(e.target) && e.target !== notificationBtn) {
                          notificationDropdown.classList.remove('active');
                      }
                  });
              }
          });
      </script>
  </body>
    </html>
